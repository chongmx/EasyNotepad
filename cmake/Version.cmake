# Writes enp/Version.h: the version (from the VERSION file), the commit and whether this is a
# release build. Run at build time (cmake -P) by the enp_version target, so the commit is the
# one being built, not the one of the last configure; the header is rewritten only when its
# content changes, so an unchanged build recompiles nothing.
#
#   -DVERSION=1.1.0 -DSOURCE_DIR=<repository> -DOUTPUT=<.../enp/Version.h> [-DRELEASE_TAG=v1.1.0]
#
# A release build: RELEASE_TAG (CI, building a pushed tag) is v<VERSION>, or the commit is tagged
# v<VERSION> and the tree has no changes. Anything else is a development build: its version reads
# <VERSION>-dev+<commit>, with ".dirty" when the tree has changes.

# A script run with -P starts with no policies: without this, if(... IN_LIST ...) is an error.
cmake_minimum_required(VERSION 3.22)

set(commit "")
set(dirty FALSE)
set(tagged FALSE)
find_package(Git QUIET)
if(GIT_FOUND AND EXISTS "${SOURCE_DIR}/.git") # a file in a worktree, a folder otherwise
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --short=7 HEAD
                    WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE commit
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=no --ignore-submodules=dirty
                    WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE changes
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(changes)
        set(dirty TRUE)
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" tag --points-at HEAD
                    WORKING_DIRECTORY "${SOURCE_DIR}" OUTPUT_VARIABLE tags
                    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    string(REPLACE "\n" ";" tags "${tags}")
    if("v${VERSION}" IN_LIST tags)
        set(tagged TRUE)
    endif()
endif()

if(RELEASE_TAG AND NOT RELEASE_TAG STREQUAL "v${VERSION}")
    message(FATAL_ERROR "Release tag ${RELEASE_TAG} does not match the VERSION file (${VERSION}): "
                        "set VERSION to the release's version, or tag v${VERSION}.")
endif()

if(RELEASE_TAG OR (tagged AND NOT dirty))
    set(release 1)
    set(full "${VERSION}")
else()
    set(release 0)
    set(full "${VERSION}-dev")
    if(commit)
        string(APPEND full "+${commit}")
        if(dirty)
            string(APPEND full ".dirty")
        endif()
    endif()
endif()
if(NOT commit)
    set(commit "unknown")
endif()

set(content "// Generated by cmake/Version.cmake from the VERSION file and git: do not edit.
#pragma once

#define ENP_VERSION \"${VERSION}\" // the release this is, or leads to
#define ENP_VERSION_FULL \"${full}\" // what a bug report should quote
#define ENP_COMMIT \"${commit}\"
#define ENP_RELEASE ${release} // 1: built from the release's tag
")

set(old "")
if(EXISTS "${OUTPUT}")
    file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
    file(WRITE "${OUTPUT}" "${content}")
endif()

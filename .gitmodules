[submodule "3rdparty/imgui"]
	path = 3rdparty/imgui
	branch = docking
	url = https://github.com/ocornut/imgui.git
	ignore = dirty
[submodule "3rdparty/IconFontCppHeaders"]
	path = 3rdparty/IconFontCppHeaders
	url = https://github.com/juliettef/IconFontCppHeaders.git
	ignore = dirty
[submodule "3rdparty/llama.cpp"]
	path = 3rdparty/llama.cpp
